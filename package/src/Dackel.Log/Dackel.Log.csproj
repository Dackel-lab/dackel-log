<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Normaliza caminhos no PDB para não expor usuário/estrutura da máquina de build. -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>

    <IsPackable>true</IsPackable>
    <PackageId>Dackel.Log</PackageId>
    <AssemblyName>Dackel.Log</AssemblyName>
    <RootNamespace>Dackel.Log</RootNamespace>
    <Title>Dackel.Log</Title>
    <Version>1.0.5</Version>
    <Authors>Dackel Lab</Authors>
    <Company>Dackel Lab</Company>
    <Copyright>Copyright (c) 2026 Dackel Lab</Copyright>
    <Description>Dackel.Log: componente de logging estruturado para APIs .NET 8 e .NET 10 com Serilog em JSON compacto, correlação por traceId (W3C), sanitização de dados sensíveis, cadeia recursiva de exceções, middlewares de correlação e logging de exceções e handler pronto para ProblemDetails.</Description>
    <PackageTags>logging;serilog;observability;tracing;aspnetcore;problem-details</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/Dackel-lab/dackel-log</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://dackel-log.pages.dev</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../../RELEASE_NOTES.md'))</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- README da raiz do repositório empacotado na raiz do .nupkg -->
    <None Include="../../../README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Serilog.AspNetCore" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
  </ItemGroup>

</Project>
